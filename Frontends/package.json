{
  "name": "smartfactory-frontends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:api && npm run typecheck && vite build",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:compat": "node node_modules/typescript/bin/tsc6 --noEmit --stableTypeOrdering",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "antd": "6.6.4",
    "echarts": "6.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "@tanstack/react-query": "5.104.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "openapi-typescript": "7.13.0",
    "vite": "8.1.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@typescript/old": "npm:typescript@6.0.2"
  }
}
