{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "ai": {
          "type": "boolean"
        },
        "department_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "name",
        "department_id",
        "roles",
        "source",
        "session_id",
        "ai"
      ],
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "at_ms": {
          "format": "int64",
          "type": "integer"
        },
        "binding": {
          "type": "string"
        },
        "local": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        },
        "step_up": {
          "type": "boolean"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "role",
        "at_ms",
        "binding",
        "local",
        "step_up",
        "actor"
      ],
      "type": "object"
    },
    "Execution": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "approval_expires_ms": {
          "format": "int64",
          "type": "integer"
        },
        "approvals": {
          "items": {
            "$ref": "#/$defs/Approval"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "binding": {
          "type": "string"
        },
        "coordinator_id": {
          "type": "string"
        },
        "created_ms": {
          "format": "int64",
          "type": "integer"
        },
        "definition_id": {
          "type": "string"
        },
        "definition_version": {
          "format": "int64",
          "type": "integer"
        },
        "downlink_id": {
          "type": "string"
        },
        "fence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "override": {
          "type": "boolean"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "risk_category": {
          "type": "string"
        },
        "risk_level": {
          "format": "int64",
          "type": "integer"
        },
        "snapshot": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "start_deadline_ms": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StepResult"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "downlink_id",
        "definition_id",
        "definition_version",
        "params",
        "status",
        "override",
        "risk_category",
        "risk_level",
        "binding",
        "created_ms",
        "approval_expires_ms",
        "start_deadline_ms",
        "approvals",
        "steps",
        "snapshot",
        "actor",
        "fence",
        "version"
      ],
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "asset_version": {
          "format": "int64",
          "type": "integer"
        },
        "definition_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "entity_revision": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "late": {
          "type": "boolean"
        },
        "message_id": {
          "type": "string"
        },
        "observed_ms": {
          "format": "int64",
          "type": "integer"
        },
        "origin_id": {
          "type": "string"
        },
        "quality": {
          "enum": [
            "GOOD",
            "BAD",
            "UNCERTAIN"
          ],
          "type": "string"
        },
        "quality_reason": {
          "type": "string"
        },
        "received_ms": {
          "format": "int64",
          "type": "integer"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "rule_version": {
          "format": "int64",
          "type": "integer"
        },
        "source_id": {
          "type": "string"
        },
        "source_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "time_source": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "description": "Lossless JSON value. Clients must preserve integers outside the JavaScript safe integer range."
        }
      },
      "required": [
        "id",
        "message_id",
        "source_id",
        "source_sequence",
        "device_id",
        "key",
        "value",
        "observed_ms",
        "received_ms",
        "quality",
        "time_source",
        "entity_revision",
        "asset_version",
        "late",
        "revision"
      ],
      "type": "object"
    },
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string"
        },
        "finished_ms": {
          "format": "int64",
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "started_ms": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "command_id",
        "status",
        "message",
        "started_ms",
        "finished_ms"
      ],
      "type": "object"
    }
  },
  "$id": "https://smartfactory.local/contracts/1.0/Execution.schema.json",
  "$ref": "#/$defs/Execution",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution"
}
