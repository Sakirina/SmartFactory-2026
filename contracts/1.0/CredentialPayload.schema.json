        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "CredentialPayload": {
      "additionalProperties": false,
      "properties": {
        "credential_ref": {
          "type": "string"
        },
        "payload": {},
        "reference": {
          "$ref": "#/$defs/ConfigurationReference"
        }
      },
      "required": [
        "reference",
        "credential_ref",
        "payload"
      ],
      "type": "object"
    }
  },
  "$id": "https://smartfactory.local/contracts/1.0/CredentialPayload.schema.json",
  "$ref": "#/$defs/CredentialPayload",
