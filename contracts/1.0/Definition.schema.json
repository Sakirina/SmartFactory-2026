          "type": "string"
        },
        "to_port": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "from_port",
        "to",
        "to_port"
      ],
      "type": "object"
    },
    "Definition": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "analysis"
              }
            }
          },
          "then": {
            "properties": {
              "nodes": {
                "items": {
                  "properties": {
                    "type": {
                      "enum": [
                        "aggregate",
                        "branch",
                        "counter",
                        "expression",
                        "input",
                        "output"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "alarm"
              }
            }
          },
          "then": {
            "properties": {
              "nodes": {
                "items": {
                  "properties": {
                    "type": {
                      "enum": [
                        "aggregate",
                        "alarm",
                        "branch",
                        "debounce",
                        "expression",
                        "hysteresis",
                        "input",
                        "threshold"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "strategy"
              }
            }
          },
          "then": {
            "properties": {
              "nodes": {
                "items": {
                  "properties": {
                    "type": {
                      "enum": [
                        "action",
                        "branch",
                        "condition",
                        "debounce",
                        "expression",
                        "hysteresis",
                        "input",
                        "threshold"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Versioned analysis, alarm or strategy graph. POST draft validate additionally checks references, dependencies, expression limits and control failure branches.",
      "properties": {
        "connections": {
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "maxItems": 512,
          "type": [
            "array",
            "null"
          ]
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "effective_ms": {
          "format": "int64",
          "type": "integer"
        },
        "group_id": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "analysis",
            "alarm",
            "strategy"
          ],
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Output"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "schema_version": {
          "const": "1.0",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/Selector"
        },
        "status": {
          "enum": [
            "",
            "draft",
            "published",
            "inactive"
          ],
          "type": "string"
        },
        "version": {
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "schema_version",
