{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "ai": {
          "type": "boolean"
        },
        "department_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "name",
        "department_id",
        "roles",
        "source",
        "session_id",
        "ai"
      ],
      "type": "object"
    },
    "ConfigurationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "connector": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectorConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "credential_ref": {
          "type": "string"
        },
        "dynamic": {
          "type": "boolean"
        },
        "node_id": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ConfigurationReference"
        },
        "schema": {
          "additionalProperties": {},
          "type": [
            "object",
            "null"
          ]
        },
        "value": {}
      },
      "required": [
        "reference",
        "node_id",
        "program",
        "purpose",
        "dynamic"
      ],
      "type": "object"
    },
    "ConfigurationReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "parameter",
            "connector"
          ],
          "type": "string"
        },
        "version": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "ConnectorConfiguration": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "config": {},
        "connector_id": {
          "type": "string"
        },
        "credential_ref": {
          "type": "string"
        },
        "edge_id": {
          "type": "string"
        },
        "group_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "updated_ms": {
          "format": "int64",
          "type": "integer"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "connector_id",
        "edge_id",
        "group_id",
        "protocol",
        "version",
        "config",
        "updated_ms",
        "actor"
      ],
      "type": "object"
    }
  },
  "$id": "https://smartfactory.local/contracts/1.0/ConfigurationEnvelope.schema.json",
  "$ref": "#/$defs/ConfigurationEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigurationEnvelope"
}
