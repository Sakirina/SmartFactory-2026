{
  "$defs": {
    "AssetVersion": {
      "additionalProperties": false,
      "properties": {
        "effective_ms": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "sampling_ms": {
          "format": "int64",
          "type": "integer"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "effective_ms",
        "parent_id",
        "sampling_ms"
      ],
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "asset_version": {
          "format": "int64",
          "type": "integer"
        },
        "definition_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "entity_revision": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "late": {
          "type": "boolean"
        },
        "message_id": {
          "type": "string"
        },
        "observed_ms": {
          "format": "int64",
          "type": "integer"
        },
        "origin_id": {
          "type": "string"
        },
        "quality": {
          "enum": [
            "GOOD",
            "BAD",
            "UNCERTAIN"
          ],
          "type": "string"
        },
        "quality_reason": {
          "type": "string"
        },
        "received_ms": {
          "format": "int64",
          "type": "integer"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "rule_version": {
          "format": "int64",
          "type": "integer"
        },
        "source_id": {
          "type": "string"
        },
        "source_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "time_source": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "description": "Lossless JSON value. Clients must preserve integers outside the JavaScript safe integer range."
        }
      },
      "required": [
        "id",
        "message_id",
        "source_id",
        "source_sequence",
        "device_id",
        "key",
        "value",
        "observed_ms",
        "received_ms",
        "quality",
        "time_source",
        "entity_revision",
        "asset_version",
        "late",
        "revision"
      ],
      "type": "object"
    },
    "RuntimeState": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "candidate": {
          "type": "boolean"
        },
        "count": {
          "format": "int64",
          "type": "integer"
        },
        "last_ms": {
          "format": "int64",
          "type": "integer"
        },
        "previous": {},
        "since_ms": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "active",
        "candidate",
        "since_ms",
        "count",
        "previous",
        "last_ms"
      ],
      "type": "object"
    },
    "SimulationClock": {
      "additionalProperties": false,
      "properties": {
        "at_ms": {
          "anyOf": [
            {
              "format": "int64",
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness_at_ms": {
          "anyOf": [
            {
              "format": "int64",
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness_ms": {
          "anyOf": [
            {
              "format": "int64",
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "step_ms": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "SimulationRequest": {
      "additionalProperties": false,
      "properties": {
        "asset_versions": {
          "items": {
            "$ref": "#/$defs/AssetVersion"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "clock": {
          "$ref": "#/$defs/SimulationClock"
        },
        "expected_version": {
          "anyOf": [
            {
              "format": "int64",
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "initial_state": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/RuntimeState"
            },
            "type": [
              "object",
              "null"
            ]
          },
          "type": [
            "object",
            "null"
          ]
        },
        "order": {
          "type": "string"
        },
        "point": {
          "anyOf": [
            {
              "$ref": "#/$defs/Observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "timeout_ms": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "$id": "https://smartfactory.local/contracts/1.0/SimulationRequest.schema.json",
  "$ref": "#/$defs/SimulationRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulationRequest"
}
