          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
