          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "missing": {
          "format": "int64",
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "to_ms": {
          "format": "int64",
          "type": "integer"
        }
      },
