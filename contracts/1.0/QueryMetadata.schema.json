  "$id": "https://smartfactory.local/contracts/1.0/QueryMetadata.schema.json",
  "$ref": "#/$defs/QueryMetadata",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QueryMetadata"
