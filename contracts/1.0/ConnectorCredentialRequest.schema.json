{
  "$defs": {
    "ConfigurationReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "parameter",
            "connector"
          ],
          "type": "string"
        },
        "version": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "ConnectorCredentialRequest": {
      "additionalProperties": false,
      "properties": {
        "release_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseConfigurationTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "$ref": "#/$defs/CredentialResolution"
        }
      },
      "required": [
        "resolution"
      ],
      "type": "object"
    },
    "CredentialResolution": {
      "additionalProperties": false,
      "properties": {
        "credential_ref": {
          "minLength": 1,
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ConfigurationReference"
        }
      },
      "required": [
        "reference",
        "credential_ref",
        "purpose"
      ],
      "type": "object"
    },
    "ReleaseConfigurationTarget": {
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "type": "string"
        },
        "generation": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/ConfigurationReference"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "deployment_id",
        "generation",
        "references"
      ],
      "type": "object"
    }
  },
  "$id": "https://smartfactory.local/contracts/1.0/ConnectorCredentialRequest.schema.json",
  "$ref": "#/$defs/ConnectorCredentialRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorCredentialRequest"
}
