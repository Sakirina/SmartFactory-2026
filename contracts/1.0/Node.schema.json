{
  "$defs": {
    "Node": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "key": {
                    "description": "留空时使用当前观测，指定字段时使用同设备在观测时刻之前的最新值",
                    "title": "输入字段",
                    "type": "string"
                  }
                },
                "required": [],
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aggregate"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "function": {
                    "description": "对窗口中质量为 GOOD 的数值进行聚合",
                    "enum": [
                      "max",
                      "min",
                      "sum",
                      "count",
                      "avg"
                    ],
                    "minLength": 1,
                    "title": "聚合函数",
                    "type": "string"
                  }
                },
                "required": [
                  "function"
                ],
                "type": "object"
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "expression"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "code": {
                    "description": "允许算术、比较、逻辑判断以及 min、max、abs、round、choose，最多 4096 字节",
                    "minLength": 1,
                    "title": "表达式",
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "type": "object"
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "threshold"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "operator": {
                    "default": "\u003e=",
                    "description": "按照指定运算符比较输入值与判断值",
                    "enum": [
                      "==",
                      "!=",
                      "\u003e",
                      "\u003e=",
                      "\u003c",
                      "\u003c=",
                      ""
                    ],
                    "title": "比较运算符",
                    "type": "string"
                  },
                  "value": {
                    "description": "等值比较保留 JSON 值类型，大小比较使用数值",
                    "title": "判断值"
                  }
                },
                "required": [
                  "value"
                ],
                "type": "object"
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hysteresis"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "direction": {
                    "default": "above",
                    "description": "above 在上限激活，below 在下限激活",
                    "enum": [
                      "above",
                      "below",
                      ""
                    ],
                    "title": "激活方向",
                    "type": "string"
                  },
                  "high": {
                    "description": "达到上限时切换状态",
                    "title": "上限",
                    "type": "number"
                  },
                  "low": {
                    "description": "达到下限时恢复状态，下限不得大于上限",
                    "title": "下限",
                    "type": "number"
                  }
                },
                "required": [
                  "high",
                  "low"
                ],
                "type": "object"
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "debounce"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "duration_ms": {
                    "description": "候选状态持续达到指定时间后切换",
                    "maximum": 86400000,
                    "minimum": 1,
                    "title": "等待时间",
                    "type": "integer",
                    "x-unit": "ms"
                  },
                  "mode": {
                    "default": "both",
                    "description": "both 对两个方向延时，activation 在取消激活时立即恢复",
                    "enum": [
                      "both",
                      "activation",
                      ""
                    ],
                    "title": "延时模式",
                    "type": "string"
                  }
                },
                "required": [
                  "duration_ms"
                ],
                "type": "object"
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "counter"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "mode": {
                    "default": "count",
                    "description": "count 每条有效观测加一，delta 累加输入整数，rising 统计布尔值上升沿",
                    "enum": [
                      "count",
                      "delta",
                      "rising",
                      ""
                    ],
                    "title": "计数方式",
                    "type": "string"
                  }
                },
                "required": [],
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "output"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {},
                "required": [],
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "alarm"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "severity": {
                    "default": "WARNING",
                    "description": "告警记录使用的级别",
                    "title": "告警级别",
                    "type": "string"
                  }
                },
                "required": [],
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "condition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "operator": {
                    "default": "\u003e=",
                    "description": "按照指定运算符比较输入值与判断值",
                    "enum": [
                      "==",
                      "!=",
                      "\u003e",
                      "\u003e=",
                      "\u003c",
                      "\u003c=",
                      ""
                    ],
                    "title": "比较运算符",
                    "type": "string"
                  },
                  "value": {
                    "description": "等值比较保留 JSON 值类型，大小比较使用数值",
                    "title": "判断值"
                  }
                },
                "required": [
                  "value"
                ],
                "type": "object"
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {},
                "required": [],
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "branch"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": true,
                "properties": {
                  "operator": {
                    "default": "\u003e=",
                    "description": "按照指定运算符比较输入值与判断值",
                    "enum": [
                      "==",
                      "!=",
                      "\u003e",
                      "\u003e=",
                      "\u003c",
                      "\u003c=",
                      ""
                    ],
                    "title": "比较运算符",
                    "type": "string"
                  },
                  "value": {
                    "description": "等值比较保留 JSON 值类型，大小比较使用数值",
                    "title": "判断值"
                  }
                },
                "required": [
                  "value"
                ],
                "type": "object"
              }
            },
            "required": [
              "params"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "params": {
          "additionalProperties": {},
          "type": [
            "object",
            "null"
          ]
        },
        "position": {
          "additionalProperties": {
            "type": "number"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "type": {
          "enum": [
            "input",
            "aggregate",
            "expression",
            "threshold",
            "hysteresis",
            "debounce",
            "counter",
            "output",
            "alarm",
            "condition",
            "action",
            "branch"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    }
  },
  "$id": "https://smartfactory.local/contracts/1.0/Node.schema.json",
  "$ref": "#/$defs/Node",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node"
}
