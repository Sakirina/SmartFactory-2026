        "127.0.0.1:14223:4222",
        "127.0.0.1:18223:8222"
      ],
      "volumes": [
        "../.local/site/nats-2.conf:/config/nats.conf:ro",
        "../.local/site/pki/nats-2.pem:/certs/nats-2.pem:ro",
        "../.local/site/pki/nats-2.key:/certs/nats-2.key:ro",
        "../.local/site/pki/ca.pem:/certs/ca.pem:ro",
        "nats-2:/data"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "nats-3": {
      "image": "library/nats@sha256:383e95bac92d099fa612f6bbe5c4c83ae15af22e409a89fecd2e3c5092a8b2dc",
